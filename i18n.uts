import { createI18n } from 'vue-i18n'
import en from './locale/en.json'
import zhHans from './locale/zh-Hans.json'
import zhHant from './locale/zh-Hant.json'

const LOCALE_STORAGE_KEY = 'app-locale'

export type LocaleType = 'zh-Hans' | 'zh-Hant' | 'en'

/** 可选语言列表 */
export const localeOptions : LocaleType[] = ['zh-Hans', 'zh-Hant', 'en']

/** 语言在自身语言下的显示名（不做翻译） */
export const localeLabel = (l : string) : string => {
  if (l == 'zh-Hant') {
    return '繁體中文'
  }
  if (l == 'en') {
    return 'English'
  }
  return '简体中文'
}

/** 把系统语言串归一化为受支持的语言 */
const resolveLocale = (lang : string | null) : LocaleType => {
  const l = (lang ?? '').toLowerCase()
  if (l.indexOf('zh-hant') == 0 || l.indexOf('zh-tw') == 0 || l.indexOf('zh-hk') == 0 || l.indexOf('zh-mo') == 0) {
    return 'zh-Hant'
  }
  if (l.indexOf('zh') == 0) {
    return 'zh-Hans'
  }
  return 'en'
}

/** 初始语言：优先用户选择（storage），其次系统语言 */
const initialLocale = () : LocaleType => {
  const saved = uni.getStorageSync(LOCALE_STORAGE_KEY)
  if (typeof saved == 'string' && (saved as string).length > 0) {
    return saved as LocaleType
  }
  return resolveLocale(uni.getAppBaseInfo().appLanguage)
}

export const i18n = createI18n({
  legacy: false,
  locale: initialLocale(),
  fallbackLocale: 'en',
  messages: {
    en,
    'zh-Hans': zhHans,
    'zh-Hant': zhHant
  }
})

/** 把当前语言同步给运行时（影响 pages.json 的 %key% 文案，Web 平台支持） */
export const syncRuntimeLocale = () : void => {
  // #ifdef WEB
  uni.setLocale(i18n.global.locale.value)
  // #endif
}

/** 切换应用语言并持久化 */
export const setAppLocale = (l : LocaleType) : void => {
  i18n.global.locale.value = l
  uni.setStorageSync(LOCALE_STORAGE_KEY, l)
  syncRuntimeLocale()
}

/** 跟随系统语言变化（用户手动选过则不再跟随） */
export const watchSystemLocale = () : void => {
  uni.onLocaleChange((res) => {
    const saved = uni.getStorageSync(LOCALE_STORAGE_KEY)
    if (typeof saved == 'string' && (saved as string).length > 0) {
      return
    }
    i18n.global.locale.value = resolveLocale(res.locale)
    syncRuntimeLocale()
  })
}
