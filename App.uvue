<script setup lang="uts">
  import { checkSystemTheme } from '@/store/index.uts'
  import { watchSystemLocale, syncRuntimeLocale } from '@/i18n.uts'

  onLaunch((_res : OnLaunchOptions) => {
    // 获取系统主题（用于卡片 / 文本暗色判断）
    checkSystemTheme()
    // 跟随系统语言变化（初始语言在 i18n.uts 中已确定）
    watchSystemLocale()
    // 同步运行时语言（pages.json 的 %key% 文案，Web 平台）
    syncRuntimeLocale()
  })

  onError((err : any) => {
    // 仅保留错误日志；演示专用统计上报 / 计数器已移除
    console.error('App Error', err)
  })
</script>

<style>
  /*每个页面公共css */
  @import "./common/uni.css";

  /* #ifdef WEB */
  .uni-top-window uni-tabbar .uni-tabbar {
    background-color: #fff !important;
  }
  /* #endif */
  /* #ifdef MP-WEIXIN */
  page {
    background-color: #efeff4;
  }
  /* 适配暗黑模式 */
  @media (prefers-color-scheme: dark) {
    page {
      background-color: #646464;
    }
  }
  /* #endif */

  /* #ifdef VUE3-VAPOR || WEB || MP-WEIXIN */
  page {
    --page-padding: 16px;
  }
  /* #endif */
</style>
