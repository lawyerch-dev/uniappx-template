  .ai-demo {
    padding: 16px;
  }

  .ai-demo__title {
    font-size: 20px;
    font-weight: bold;
    color: #333333;
  }

  .ai-demo__desc {
    margin-top: 8px;
    font-size: 14px;
    color: #999999;
  }

  .ai-demo__card {
    margin-top: 16px;
    padding: 16px;
    border-radius: 8px;
    background-color: #f8f8f8;
  }

  .ai-demo__label {
    font-size: 16px;
    color: #333333;
  }

  .ai-demo__row {
    margin-top: 12px;
    flex-direction: row;
    align-items: center;
  }

  .ai-demo__btn {
    margin-right: 8px;
    padding: 8px 16px;
    font-size: 14px;
    border-radius: 6px;
    background-color: #007aff;
    color: #ffffff;
  }

  .ai-demo__input {
    flex: 1;
    height: 40px;
    padding: 0 12px;
    margin-right: 8px;
    font-size: 14px;
    border-radius: 6px;
    background-color: #ffffff;
  }

  .ai-demo__hint {
    margin-top: 12px;
    font-size: 13px;
    color: #999999;
  }

  .ai-demo__list {
    margin-top: 12px;
  }

  .ai-demo__item {
    padding: 12px;
    margin-bottom: 8px;
    border-radius: 6px;
    background-color: #ffffff;
  }

  .ai-demo__item-text {
    font-size: 14px;
    color: #333333;
  }
</style>