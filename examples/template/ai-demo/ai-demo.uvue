<template>
  <scroll-view style="flex: 1">
    <view class="ai-demo">
      <text class="ai-demo__title">AI 演示页</text>
      <text class="ai-demo__desc">由 opencode 生成的 uni-app x 蒸汽模式示例，用于校验开发规范。</text>

      <view class="ai-demo__card">
        <text class="ai-demo__label">计数器：{{ data.count }}</text>
        <view class="ai-demo__row">
          <button class="ai-demo__btn" @click="decrease()">-1</button>
          <button class="ai-demo__btn" @click="increase()">+1</button>
        </view>
        <text class="ai-demo__hint">计算属性（翻倍）：{{ doubled }}</text>
      </view>

      <view class="ai-demo__card">
        <text class="ai-demo__label">待办列表</text>
        <view class="ai-demo__row">
          <input class="ai-demo__input" v-model="data.inputText" placeholder="输入待办内容" />
          <button class="ai-demo__btn" @click="addTodo()">添加</button>
        </view>
        <view class="ai-demo__list">
          <view class="ai-demo__item" v-for="(item, index) in data.todos" :key="item.id" @click="removeTodo(index)">
            <text class="ai-demo__item-text">{{ index + 1 }}. {{ item.text }}</text>
          </view>
        </view>
        <text class="ai-demo__hint" v-if="data.todos.length === 0">暂无待办，输入后点击添加</text>
      </view>
    </view>
  </scroll-view>
</template>

<script setup lang="uts">
  type TodoItem = {
    id: number
    text: string
  }

  type DataType = {
    count: number
    inputText: string
    todos: TodoItem[]
  }

  const data = reactive({
    count: 0,
    inputText: '',
    todos: [] as TodoItem[]
  } as DataType)

  const doubled = computed((): number => {
    return data.count * 2
  })

  const increase = (): void => {
    data.count++
  }

  const decrease = (): void => {
    data.count--
  }

  const addTodo = (): void => {
    const text = data.inputText.trim()
    if (text === '') {
      uni.showToast({
        title: '请输入内容',
        icon: 'none'
      })
      return
    }
    data.todos.push({
      id: data.todos.length + 1,
      text: text
    } as TodoItem)
    data.inputText = ''
  }

  const removeTodo = (index: number): void => {
    data.todos.splice(index, 1)
  }

  defineExpose({
    data
  })
</script>

